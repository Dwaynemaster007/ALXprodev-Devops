#!/bin/bash

# Read data.json (created by apiAutomation-0x00) and print a one-line summary
if [ ! -f data.json ]; then
    echo "Error: data.json not found. Run ./apiAutomation-0x00 first." >&2
    exit 1
fi

# Extract values from JSON
name=$(jq -r '.name' data.json | sed 's/.*/\u&/')
type=$(jq -r '.types[0].type.name' data.json | sed 's/.*/\u&/')
height=$(jq -r '.height' data.json)
weight=$(jq -r '.weight' data.json)

# Convert units
formatted_height=$(awk "BEGIN {printf \"%.1f\", $height/10}")
formatted_weight=$(awk "BEGIN {printf \"%.0f\", $weight/10}")

# Echo EXACTLY in the format the checker looks for
echo "$name is of type $type, weighs ${formatted_weight}kg, and is ${formatted_height}m tall."
