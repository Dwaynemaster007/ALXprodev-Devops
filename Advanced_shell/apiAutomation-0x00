#!/bin/bash
# Fetch Pikachu from the PokéAPI and save it to data.json; log failures to errors.txt

OUTPUT_FILE="data.json"
ERROR_FILE="errors.txt"
API_URL="https://pokeapi.co/api/v2/pokemon/pikachu"
TMP_FILE=$(mktemp)
trap 'rm -f "$TMP_FILE"' EXIT

HTTP_STATUS=$(curl -s -o "$TMP_FILE" -w "%{http_code}" "$API_URL")

if [ "$HTTP_STATUS" != "200" ]; then
    echo "[$(date)] API request to $API_URL failed with status $HTTP_STATUS" >> "$ERROR_FILE"
    echo "Request failed (status $HTTP_STATUS). See $ERROR_FILE." >&2
    exit 1
fi

# Only replace data.json once we know the response is good
mv "$TMP_FILE" "$OUTPUT_FILE"
echo "Data successfully saved to $OUTPUT_FILE"
